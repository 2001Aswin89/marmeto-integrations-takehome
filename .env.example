PORT=3000
WEBHOOK_SECRET=dev-secret-change-me
COURIER_BASE_URL=http://localhost:4000
MOCK_COURIER_PORT=4000
DB_PATH=./data.db
COURIER_TIMEOUT_MS=5000
MAX_ATTEMPTS=5
MAX_RATE_LIMIT_HITS=20
MAX_RECONCILE_REQUEUES=3
LEASE_MS=60000
WORKER_POLL_MS=500
RECONCILE_MIN_AGE_MS=120000
