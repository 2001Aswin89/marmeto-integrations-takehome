{
  "name": "marmeto-integrations-takehome",
  "version": "0.1.0",
  "private": true,
  "description": "orders/create webhook -> courier shipment service with idempotency, retries and reconciliation",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "concurrently -k -n courier,service \"node mock-courier.js\" \"tsx --disable-warning=ExperimentalWarning src/server.ts\"",
    "demo:hang": "concurrently -k -n courier,service \"node mock-courier.js --force hang\" \"tsx --disable-warning=ExperimentalWarning src/server.ts\"",
    "demo:500": "concurrently -k -n courier,service \"node mock-courier.js --force 500\" \"tsx --disable-warning=ExperimentalWarning src/server.ts\"",
    "mock": "node mock-courier.js",
    "service": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "send-webhook": "tsx src/scripts/send-webhook.ts",
    "reconcile": "tsx --disable-warning=ExperimentalWarning src/scripts/reconcile.ts",
    "failed": "tsx --disable-warning=ExperimentalWarning src/scripts/jobs.ts failed",
    "replay": "tsx --disable-warning=ExperimentalWarning src/scripts/jobs.ts replay",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
